{
  "name": "notch-hub",
  "version": "0.1.0",
  "description": "Central estilo notch para Windows com assistente de IA local (Ollama)",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "start:open": "electron . --open",
    "icon": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/make-icon.ps1",
    "shortcuts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-shortcuts.ps1"
  },
  "devDependencies": {
    "electron": "45.3.4"
  }
}
